# Команды требуют проверки последствий; это не анализ произвольного кода скриптов.
prefix_rule(pattern = [["rm", "/usr/bin/rm", "/bin/rm", "rmdir", "unlink", "shred"]], decision = "prompt", justification = "Сначала покажите точные удаляемые пути и получите согласие")
prefix_rule(pattern = [["mv", "/usr/bin/mv", "/bin/mv"]], decision = "prompt", justification = "Проверьте перезапись существующих файлов и перенос за пределы задачи")
prefix_rule(pattern = [["git", "/usr/bin/git"], ["reset", "clean", "restore", "checkout", "switch", "rebase", "merge", "branch", "tag", "stash", "update-ref", "read-tree", "checkout-index"]], decision = "prompt", justification = "Изменение состояния Git может затронуть чужую или несохранённую работу")
prefix_rule(pattern = [["git", "/usr/bin/git"], ["push", "send-pack"]], decision = "prompt", justification = "Публикация коммитов требует согласования назначения")
prefix_rule(pattern = [["git", "/usr/bin/git"], ["-C", "-c", "--git-dir", "--work-tree"]], decision = "prompt", justification = "Проверьте действие Git с глобальными опциями; для обычного чтения используйте cwd команды")
prefix_rule(pattern = ["docker", ["run", "exec", "stop", "kill", "rm", "rmi", "restart", "start", "update"]], decision = "prompt", justification = "Контейнерная операция может изменить сервисы или сохранённые данные")
prefix_rule(pattern = ["docker", "system", "prune"], decision = "prompt", justification = "Очистка Docker может удалить данные других проектов")
prefix_rule(pattern = ["docker", "volume", ["rm", "prune"]], decision = "prompt", justification = "Удаление volumes может уничтожить данные")
prefix_rule(pattern = ["docker", "compose", ["up", "down", "stop", "start", "restart", "rm", "kill", "run", "exec", "build", "pull"]], decision = "prompt", justification = "Сначала согласуйте затрагиваемые сервисы и данные")
prefix_rule(pattern = ["docker", "compose", ["-f", "--file", "-p", "--project-name", "--profile"]], decision = "prompt", justification = "Проверьте Compose-команду после глобальных опций")
prefix_rule(pattern = ["docker-compose"], decision = "prompt", justification = "Проверьте действие Compose и целевое окружение")
prefix_rule(pattern = [["terraform", "tofu"], ["apply", "destroy", "import", "state", "force-unlock"]], decision = "prompt", justification = "Изменение инфраструктуры и её состояния требует согласования")
prefix_rule(pattern = ["kubectl", ["apply", "delete", "patch", "replace", "edit", "create", "scale", "rollout", "exec", "run", "cp"]], decision = "prompt", justification = "Сначала согласуйте кластер, namespace и последствия")
prefix_rule(pattern = [["psql", "mysql", "mariadb", "clickhouse-client", "redis-cli", "mongosh"]], decision = "prompt", justification = "SQL и команды БД требуют проверки окружения и возможной записи")
prefix_rule(pattern = ["alembic", ["upgrade", "downgrade", "stamp"]], decision = "prompt", justification = "Изменение схемы или состояния БД требует согласования")
prefix_rule(pattern = [["sudo", "dd", "mkfs", "fdisk", "parted", "wipefs", "truncate"]], decision = "prompt", justification = "Проверьте привилегии, перезапись и потерю данных")
prefix_rule(pattern = [["kill", "pkill", "killall", "systemctl", "service"]], decision = "prompt", justification = "Проверьте владельца процесса и влияние на работающие сервисы")
prefix_rule(pattern = [["curl", "wget"]], decision = "prompt", justification = "При выходе из песочницы проверьте HTTP-метод, адрес и передаваемые данные")
prefix_rule(pattern = ["gh", "api"], decision = "prompt", justification = "Прямой API может изменять внешний сервис")
prefix_rule(pattern = ["gh", "pr", ["comment", "review", "merge", "create", "edit", "close"]], decision = "prompt", justification = "Внешняя публикация требует поручения пользователя")
prefix_rule(pattern = [["bash", "sh", "zsh"], ["-c", "-lc"]], decision = "prompt", justification = "Проверьте действия непрозрачной shell-обёртки")
prefix_rule(pattern = ["npx"], decision = "prompt", justification = "npx может скачать и выполнить новый пакет")
