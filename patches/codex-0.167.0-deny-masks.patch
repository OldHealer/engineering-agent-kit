+use super::compact_unreadable_roots;
+use std::path::PathBuf;
+
+fn paths(values: &[&str]) -> Vec<PathBuf> {
+    values.iter().map(PathBuf::from).collect()
+}
+
+#[test]
+fn thousands_of_descendant_masks_collapse_under_an_existing_deny() {
+    let mut masks = paths(&["/project/.worktrees"]);
+    masks.extend(
+        (0..10_000).map(|index| PathBuf::from(format!("/project/.worktrees/{index}/.env"))),
+    );
+    assert_eq!(
+        compact_unreadable_roots(masks),
+        paths(&["/project/.worktrees"])
+    );
+}
+
+#[test]
+fn unrelated_masks_and_similar_prefixes_are_preserved() {
+    assert_eq!(
+        compact_unreadable_roots(paths(&[
+            "/project/private",
+            "/project/private/.env",
+            "/project/private-copy/.env",
+            "/other/.env"
+        ])),
+        paths(&[
+            "/other/.env",
+            "/project/private",
+            "/project/private-copy/.env"
+        ])
+    );
+}
+
+#[test]
+fn writable_child_layer_reapplies_the_child_masks() {
+    let masks = paths(&[
+        "/project/private",
+        "/project/private/task/.env",
+        "/project/private/task/sub/key.pem",
+    ]);
+    assert_eq!(
+        compact_unreadable_roots(masks.clone()),
+        paths(&["/project/private"])
+    );
+    let child_masks = masks
+        .into_iter()
+        .filter(|path| path.starts_with("/project/private/task"))
+        .collect();
+    assert_eq!(
+        compact_unreadable_roots(child_masks),
+        paths(&[
+            "/project/private/task/.env",
+            "/project/private/task/sub/key.pem"
+        ])
+    );
+}
+
+#[test]
+fn canonical_targets_outside_a_denied_parent_remain_masked() {
+    assert_eq!(
+        compact_unreadable_roots(paths(&[
+            "/project/private",
+            "/project/private/link/.env",
+            "/real-target/.env"
+        ])),
+        paths(&["/project/private", "/real-target/.env"])
+    );
+}
+
+#[test]
+fn duplicates_empty_input_and_root_deny_are_handled() {
+    assert!(compact_unreadable_roots(Vec::new()).is_empty());
+    assert_eq!(
+        compact_unreadable_roots(paths(&["/project/private", "/project/private"])),
+        paths(&["/project/private"])
+    );
+    assert_eq!(
+        compact_unreadable_roots(paths(&["/", "/project/.env"])),
+        paths(&["/"])
+    );
+}
