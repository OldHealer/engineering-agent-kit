+#[test]
+fn compaction_keeps_thousands_of_redundant_glob_masks_below_bwrap_limit() {
+    assert!(ripgrep_available(), "this regression requires real ripgrep");
+    let temporary = TempDir::new().expect("temporary directory");
+    let blocked = temporary.path().join("blocked");
+    std::fs::create_dir(&blocked).expect("blocked directory");
+    for index in 0..2_000 {
+        std::fs::write(blocked.join(format!("{index}.env")), "fixture").expect("fixture file");
+    }
+    let entry = |path: &Path, access| FileSystemSandboxEntry {
+        path: AbsolutePathBuf::from_absolute_path(path)
+            .expect("absolute path")
+            .into(),
+        access,
+        missing_path_behavior: None,
+    };
+    let policy = FileSystemSandboxPolicy::restricted(vec![
+        FileSystemSandboxEntry {
+            path: FileSystemPath::Special {
+                value: FileSystemSpecialPath::Root,
+            },
+            access: FileSystemAccessMode::Read,
+            missing_path_behavior: None,
+        },
+        entry(temporary.path(), FileSystemAccessMode::Write),
+        entry(&blocked, FileSystemAccessMode::Deny),
+        unreadable_glob_entry(format!("{}/**/*.env", temporary.path().display())),
+    ]);
+    let result = create_filesystem_args(&policy, temporary.path(), BwrapOptions::default())
+        .expect("filesystem arguments");
+    assert!(
+        result.args.len() < 9_000,
+        "redundant deny masks exceeded bwrap limit"
+    );
+    let first = path_to_string(&blocked.join("0.env"));
+    assert!(
+        !result.args.contains(&first),
+        "parent mask already hides this file"
+    );
+    assert!(result.args.windows(6).any(|window| window
+        == [
+            "--perms",
+            "000",
+            "--tmpfs",
+            blocked.to_str().unwrap(),
+            "--remount-ro",
+            blocked.to_str().unwrap(),
+        ]));
+}
