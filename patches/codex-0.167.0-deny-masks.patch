+// Compact within a mount layer: a later writable bind must reapply its own deny masks.
+fn compact_unreadable_roots(paths: Vec<PathBuf>) -> Vec<PathBuf> {
+    let paths: BTreeSet<PathBuf> = paths.into_iter().collect();
+    paths
+        .iter()
+        .filter(|path| {
+            !path
+                .ancestors()
+                .skip(1)
+                .any(|parent| paths.contains(parent))
+        })
+        .cloned()
+        .collect()
 }
 
